---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import Icon from "astro-theme-university/components/Icon.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import IncentiveBadge from "../../components/IncentiveBadge.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const lectures = await getPublishedCollection("lectures");
  return lectures.map((lecture) => ({ params: { slug: lecture.id }, props: { lecture } }));
}

const { lecture } = Astro.props;
const { Content } = await render(lecture);
const title = `Week ${lecture.data.week}: ${lecture.data.title}`;
---

<ContentLayout title={title} description={lecture.data.description} {...siteConfig}>
  <p class="ledger">
    <strong>{formatCourseDate(lecture.data.date)}</strong> <IncentiveBadge tags={lecture.data.tags} />
  </p>
  {
    lecture.data.slides && (
      <a class="slides-preview" href={withBase(lecture.data.slides)}>
        <span class="slides-preview-thumb" aria-hidden="true">
          <Icon name="presentation" size="1.75rem" />
        </span>
        <span class="slides-preview-text">
          <strong>Open the slides</strong>
          <span class="ledger">Reveal.js deck, this week's lecture</span>
        </span>
      </a>
    )
  }
  <div class="lecture-body">
    <Content />
  </div>
  <TeachingTeam teachers={lecture.data.teachers} />
  <RelatedContent entry={lecture} collections={graphCollections} />
</ContentLayout>

<style>
  .slides-preview {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-md);
    width: fit-content;
    margin-block: var(--at-spacing-md) var(--at-spacing-lg);
    padding: var(--at-spacing-sm) var(--at-spacing-lg) var(--at-spacing-sm) var(--at-spacing-sm);
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--paper-bg);
    box-shadow: var(--at-shadow-sm);
    color: var(--at-text);
    text-decoration: none;
    transition: box-shadow 0.15s ease;
  }

  .slides-preview:hover,
  .slides-preview:focus-visible {
    box-shadow: var(--at-shadow-md);
  }

  .slides-preview-thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    height: 3.5rem;
    border: 1px solid var(--at-border);
    border-radius: calc(var(--at-border-radius) / 2);
    background: var(--at-bg-alt);
    color: var(--at-text-secondary);
  }

  .slides-preview-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* Question to carry: the one thing a lecture leaves you with, boxed and
     marked with a question-mark bubble rather than styled as a quotation.
     Overrides the theme's default blockquote (a quiet dash-accent style
     tuned for genuine quotations, not this page's own closing claim). */
  .lecture-body :global(blockquote) {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-md);
    margin-block: var(--at-spacing-xl) 0;
    padding: var(--at-spacing-md) var(--at-spacing-lg);
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--paper-bg);
    box-shadow: var(--at-shadow-sm);
    font-size: var(--at-font-size-h4);
    font-weight: 700;
    color: var(--at-heading);
  }

  .lecture-body :global(blockquote p) {
    margin: 0;
  }

  .lecture-body :global(blockquote::before) {
    content: "?";
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border: none;
    border-radius: 50%;
    background: var(--at-heading);
    color: var(--at-on-primary);
    font-family: var(--at-font-body);
    font-size: 1rem;
    font-weight: 700;
    padding-block-end: 0;
  }
</style>
